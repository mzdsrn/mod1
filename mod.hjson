#the mod name as displayed in-game
displayName: "Changing the Environment"

#the internal name of your mod
name: "changing-the-environment"

#your name
author: "No one"

#the fully qualified main class of the mod
main: "cte.JavaMod"

#the mod description as seen in the mod dialog
description: "A Java mindustry mod that lets you modify the environment, like: destroy StaticWall, make a pool."

#the mod version
version: 1.0

#the minimum game build required to run this mod
minGameVersion: 158

#this is a java mod
java: true
